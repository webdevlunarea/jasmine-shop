# Merge with the ignored .env locally/server-side. Preserve working SMTP values.
# Never commit or share an SMTP password. No real credential belongs in this example.
CI_ENVIRONMENT = production
email.protocol = 'smtp'
email.SMTPHost = 'HOST_SMTP_ANDA'
email.SMTPUser = 'EMAIL_PENGIRIM_ANDA'
email.SMTPPass = ''
email.SMTPPort = 465
email.SMTPCrypto = 'ssl'
email.fromEmail = 'EMAIL_PENGIRIM_ANDA'
email.fromName = 'Lunarea Furniture'
email.mailType = 'html'
# Use the port/encryption required by your SMTP provider; this reflects the project's existing default.
