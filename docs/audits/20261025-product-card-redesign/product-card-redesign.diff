diff --git a/public/css/storefront-catalog.css b/public/css/storefront-catalog.css
index b238478..d4a277e 100644
--- a/public/css/storefront-catalog.css
+++ b/public/css/storefront-catalog.css
@@ -236,3 +236,28 @@ body:not(.admin-body) .flash-sale-section :is(a,button):focus-visible { outline:
     body:not(.admin-body) .flash-sale-price span { font-size: .875rem; }
 }
 @media (prefers-reduced-motion: reduce) { body:not(.admin-body) .flash-sale-card { transition: none; } }
+
+/* Refined product cards: editorial image ratio, restrained labels, and flat chrome. */
+body:not(.admin-body) .card-group1.no-scroll:has(> .store-product-card) { gap: 34px 22px; }
+body:not(.admin-body) .store-product-card { gap: 12px; padding: 0 0 2px; color: #292722; }
+body:not(.admin-body) .store-product-card > .product-card-media { aspect-ratio: 4 / 5 !important; border-radius: 2px; background: #f4f1eb; }
+body:not(.admin-body) .store-product-card .img-card1,
+body:not(.admin-body) .store-product-card .img-card1-wm { aspect-ratio: 4 / 5; border-radius: 2px; }
+body:not(.admin-body) .store-product-card .img-card1 { object-fit: cover; transition: transform .38s ease; }
+body:not(.admin-body) .store-product-card:hover .img-card1 { transform: scale(1.025); }
+body:not(.admin-body) .store-product-card > .product-card-body { gap: 8px; padding-inline: 0; }
+body:not(.admin-body) .store-product-card .product-card-heading { gap: 3px; }
+body:not(.admin-body) .store-product-card h5 { color: #292722; font-size: .875rem; font-weight: 500; letter-spacing: -.015em; }
+body:not(.admin-body) .store-product-card .product-card-heading > .varian { color: #77736d; font-size: .75rem; }
+body:not(.admin-body) .store-product-card .harga { font-size: .9375rem; font-weight: 600; }
+body:not(.admin-body) .store-product-card .diskon-coret { color: #77736d !important; }
+body:not(.admin-body) .store-product-card .product-image-discount { min-height: 25px; padding: 4px 7px; border-radius: 2px; font-size: .6875rem; font-weight: 500; }
+body:not(.admin-body) .store-product-card .terjual-badge { bottom: 8px; right: 8px; padding: 3px 6px; border-radius: 2px; }
+@media (max-width: 575.98px) {
+    body:not(.admin-body) .card-group1.no-scroll:has(> .store-product-card) { gap: 26px 12px; }
+    body:not(.admin-body) .store-product-card { gap: 9px; }
+    body:not(.admin-body) .store-product-card h5 { font-size: .8125rem; }
+}
+@media (prefers-reduced-motion: reduce) {
+    body:not(.admin-body) .store-product-card .img-card1 { transition: none; }
+}
