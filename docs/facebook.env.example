# Copy these entries into the ignored .env, then fill credentials locally.
# Keep disabled until the migration and Meta application setup are complete.
# Use the exact host and subdirectory configured in app.baseURL.
facebook.enabled = false
facebook.appId = ''
facebook.appSecret = ''
facebook.redirectUri = 'https://YOUR_HOST/auth/facebook/callback'
facebook.graphVersion = 'v25.0'

# Production recommendations. Merge with existing values instead of duplicating keys.
# CI_ENVIRONMENT = production
# app.baseURL = 'https://YOUR_HOST/'
# cookie.secure = true
# cookie.httponly = true
# cookie.samesite = 'Lax'
